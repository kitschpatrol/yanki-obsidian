{
	"name": "yanki-obsidian",
	"version": "1.13.0",
	"private": true,
	"description": "Obsidian plugin to sync flashcards from a folder in your vault to Anki. Pure Markdown syntax. No fuss.",
	"keywords": [
		"obsidian",
		"obsidian-md",
		"obsidian-plugin",
		"anki",
		"flashcards",
		"markdown",
		"spaced-repetition",
		"sync",
		"pkm"
	],
	"homepage": "https://github.com/kitschpatrol/yanki-obsidian",
	"bugs": "https://github.com/kitschpatrol/yanki-obsidian/issues",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/kitschpatrol/yanki-obsidian.git"
	},
	"license": "MIT",
	"author": {
		"name": "Eric Mika",
		"email": "eric@ericmika.com",
		"url": "https://ericmika.com"
	},
	"type": "module",
	"main": "./dist/main.js",
	"scripts": {
		"build": "tsc -noEmit -skipLibCheck && pnpm build:bundle",
		"build:bundle": "shx rm -rf ./dist && tsx ./scripts/build.ts production",
		"clean-deep": "shx rm -f pnpm-lock.yaml && git clean -fdX -e !.claude/",
		"dev": "shx rm -rf ./dist && tsx ./scripts/build.ts",
		"fix": "ksc fix",
		"lint": "ksc lint",
		"prepare": "skills experimental_sync -y -f",
		"release": "bumpp package.json manifest.json -x 'pnpm build' -c 'Release: %s' --tag '%s'",
		"test": "pnpm build --no-demo && vitest run",
		"test:e2e": "vitest run",
		"yanki:deploy-local": "shx cp -r ./dist/* ~/Notes/Vault/.obsidian/plugins/yanki",
		"yanki:use-local": "pnpm remove yanki && pnpm add -D ../yanki",
		"yanki:use-npm": "pnpm remove yanki && pnpm add -D yanki"
	},
	"devDependencies": {
		"@eslint/json": "0.14.0",
		"@kitschpatrol/cspell-config": "^8.12.1",
		"@kitschpatrol/eslint-config": "^8.12.1",
		"@kitschpatrol/knip-config": "^8.12.1",
		"@kitschpatrol/mdat-config": "^8.12.1",
		"@kitschpatrol/prettier-config": "^8.12.1",
		"@kitschpatrol/remark-config": "^8.12.1",
		"@kitschpatrol/shared-config": "^8.12.1",
		"@kitschpatrol/stylelint-config": "^8.12.1",
		"@types/node": "~20.19.43",
		"bumpp": "^12.3.0",
		"chokidar": "^5.0.0",
		"debounce": "^3.0.0",
		"entities": "^8.1.0",
		"esbuild": "^0.28.2",
		"esbuild-plugin-copy": "^2.1.1",
		"escape-string-regexp": "^5.0.0",
		"eslint-plugin-obsidianmd": "^0.4.2",
		"moment": "^2.31.0",
		"obsidian": "1.13.1",
		"obsidian-typings": "6.39.0",
		"plur": "^6.0.0",
		"pretty-ms": "^9.3.1",
		"shx": "^0.4.0",
		"skills": "^1.7.0",
		"tsx": "^4.23.15",
		"type-fest": "^5.10.0",
		"typescript": "~6.0.3",
		"vitest": "^5.0.3",
		"wdio-obsidian-service": "3.2.1",
		"webdriverio": "^9.32.0",
		"yanki": "^3.1.0"
	},
	"packageManager": "pnpm@12.9.1",
	"engines": {
		"node": "^20.19.0 || ^22.0.0 || ^24.0.0 || >=26.0.0"
	},
	"devEngines": {
		"runtime": {
			"name": "node",
			"version": "^24.16.0 || >=26.3.0"
		}
	},
	"obsidian": {
		"author": "Kitschpatrol",
		"description": "Sync flashcards from a folder in your vault to Anki. Pure Markdown syntax. No fuss.",
		"id": "yanki",
		"isDesktopOnly": true,
		"minAppVersion": "1.9.12",
		"name": "Yanki"
	}
}
